# --- LLM ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# If set, clients must send matching X-API-Key on /chat and /upload (leave empty for local dev).
# API_KEY=

# --- External tools ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_FORECAST_URL=https://api.openweathermap.org/data/2.5/forecast

# Wikipedia: MediaWiki API (осмысленный User-Agent обязателен по правилам Wikimedia).
# WIKIPEDIA_USER_AGENT=MyBot/1.0 (contact@example.com)
# WIKIPEDIA_TIMEOUT=12

# YouTube: primary provider youtube | duckduckgo (fallback всегда пробует второй).
# YOUTUBE_PRIMARY_PROVIDER=youtube
#
# YouTube Data API v3 (обязательно для стабильного поиска; ключ из Google Cloud Console, API «YouTube Data API v3»).
# Дубликат имени переменной: YOUTUBE_API_KEY (если YOUTUBE_DATA_API_KEY пуст).
# YOUTUBE_DATA_API_KEY=
# YOUTUBE_REGION_CODE=RU
# YOUTUBE_RELEVANCE_LANGUAGE=ru
# YOUTUBE_DATA_API_TIMEOUT=15

# HTTP_RETRY_ATTEMPTS=3
# HTTP_RETRY_BASE_DELAY=0.5
# DUCKDUCKGO_TIMEOUT=20

# --- Infrastructure (defaults match docker-compose) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=my_documents
# Vector dimension for the embedding model (nomic-embed-text = 768). Change if you switch models.
# QDRANT_VECTOR_SIZE=768
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# docker-compose: backend waits for ollama_init (pull) to finish. GET /ready checks Qdrant + embedding model.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=*

# Upload: max size (bytes); allowed extensions (comma, dot optional).
# UPLOAD_MAX_BYTES=15728640
# ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.png,.jpg,.jpeg,.webp

# Repro: Python 3.12 in Dockerfile; use requirements.txt + CI pytest for a verified install.
